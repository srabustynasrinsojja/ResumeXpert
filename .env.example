# ── Existing config (copy your real values from your working .env) ──
GEMINI_API_KEY=
MONGODB_URI=
MONGODB_DB_NAME=ats_platform
JWT_SECRET_KEY=change-this-to-any-random-string

# ── NEW: real-email verification (added for signup security) ──
# Uses Gmail SMTP with an App Password. A 6-digit code is emailed and must
# be entered in the app before an account becomes usable. See setup steps below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
MAIL_FROM_NAME=ResumeXpert

# ── How to get SMTP_USER / SMTP_APP_PASSWORD ──
# 1. Go to https://myaccount.google.com/security
# 2. Turn on "2-Step Verification" if it isn't already on (required for App Passwords).
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an app password (name it e.g. "ResumeXpert"), copy the 16-character code.
# 5. SMTP_USER = the Gmail address you did this on.
#    SMTP_APP_PASSWORD = the 16-character code (spaces don't matter, with or without).
# Do NOT use your normal Gmail password — Google blocks that for SMTP logins.
